{
  "name": "@home-engine/typegen",
  "version": "1.0.0-alpha.1",
  "description": "Generates entity and service typings for home-engine rules from a live Home Assistant",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "home-engine-typegen": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@home-engine/sdk": "1.0.0-alpha.1"
  },
  "devDependencies": {
    "@home-engine/engine": "1.0.0-alpha.1"
  }
}
