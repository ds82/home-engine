{
  "name": "@home-engine/engine",
  "version": "0.0.0",
  "description": "Rule engine that runs TypeScript/JavaScript rules against Home Assistant",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "bin": {
    "home-engine": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@home-engine/sdk": "0.0.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "esbuild": "^0.27.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "ws": "^8.22.0"
  }
}
